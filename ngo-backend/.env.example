# ==============================================================================
# AidLink Backend Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the backend server:
# cp .env.example .env

# Server Configuration
PORT=5000

# Database Connection (DATABASE_URL takes precedence if specified)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidlink_db

# Discrete DB Configuration Parameters (fallback if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aidlink_db

# Authentication / Security (replace with a secure random key in production)
JWT_SECRET=development_jwt_secret_key_change_in_production
